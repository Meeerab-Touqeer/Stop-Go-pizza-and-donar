# Express API
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-string

# Supabase (service role stays on the server — never expose it to Vite)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional. When set, checkout can create a Stripe PaymentIntent.
STRIPE_SECRET_KEY=

# Client (public anon key only)
# Copy these into client/.env as well if you use Google sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
