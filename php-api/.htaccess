RewriteEngine On
CGIPassAuth On

# Apache often drops Authorization unless it is copied into the request environment.
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Keep PHP source, config, and the order database off the public web.
RewriteRule ^(src|data|config\.php|config\.example\.php) - [F,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]
